# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Required — mongodb:// or mongodb+srv://
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

BCRYPT_SALT_ROUNDS=12

# Required — use a long random string (openssl rand -base64 48)
# Production requires at least 32 characters and rejects placeholders.
JWT_SECRET=

JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-client
# Access token lifetime in seconds (default 900). Production max: 3600.
JWT_ACCESS_EXPIRES_IN_SEC=900

# Required — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce

# Required — Paymob (payment integration)
PAYMOB_API_KEY=
